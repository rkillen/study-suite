{
  "name": "study-suite",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "emulators": "npx --yes firebase-tools emulators:start --project demo-study-suite",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-study-suite \"npm --prefix rules-tests test\"",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules",
    "deploy": "npm run build && npx --yes firebase-tools deploy"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

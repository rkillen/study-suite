# Used by "npm run dev:emulator". Points the app at a fake Firebase running on this computer.
# Nothing here is real, and no real data is touched.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-study-suite.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-study-suite
VITE_FIREBASE_STORAGE_BUCKET=demo-study-suite.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
